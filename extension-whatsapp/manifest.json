{
  "manifest_version": 3,
  "name": "Zap Sender - Central MEI",
  "version": "1.2.0",
  "description": "Envio automático humanizado de mensagens pelo WhatsApp Web integrado ao painel.",
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://certificadodigitalccmei.online/*",
    "https://www.certificadodigitalccmei.online/*",
    "https://certificadodigitalccmei.lovable.app/*",
    "https://*.lovable.app/*"
  ],
  "action": { "default_popup": "popup.html", "default_icon": "icon.png" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": { "48": "icon.png", "128": "icon.png" }
}
